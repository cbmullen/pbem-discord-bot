{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "outputDirectory": "public",
  "functions": {
    "api/interactions.ts": {
      "maxDuration": 30
    },
    "api/reminders.ts": {
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/reminders",
      "schedule": "0 9 * * *"
    }
  ]
}
